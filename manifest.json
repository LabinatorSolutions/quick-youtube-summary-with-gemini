{
  "manifest_version": 3,
  "name": "Quick YouTube Summary with Gemini",
  "version": "1.4",
  "author": "Labinator",
  "developer": {
    "name": "Labinator",
    "url": "https://labinator.com/"
  },
  "description": "Summarizes the Youtube video using Google Gemini",
  "permissions": [
    "activeTab",
    "notifications",
    "storage",
    "tabs"
  ],
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://youtu.be/*",
    "*://gemini.google.com/*",
    "*://*.google.com/*"
  ],
  "action": {
    "default_title": "Summarize with Gemini",
    "default_icon": {
      "16": "icon.svg",
      "48": "icon.svg",
      "128": "icon.svg"
    }
  },
  "background": {
    "scripts": [
      "config.js",
      "background.js"
    ]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icon.svg",
    "48": "icon.svg",
    "128": "icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "quick-youtube-summary-with-gemini@labinator.com",
      "strict_min_version": "150.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": []
      }
    }
  }
}